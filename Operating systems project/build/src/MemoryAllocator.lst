  40:src/MemoryAllocator.cpp **** int MemoryAllocator::kfree(void *freeAdr)
  41:src/MemoryAllocator.cpp **** {
  42:src/MemoryAllocator.cpp ****     FreeBlock* header=(FreeBlock*)((uint64)freeAdr-HEADER_SIZE);
  43:src/MemoryAllocator.cpp ****     if(header<HEAP_START_ADDR)return -1;
  44:src/MemoryAllocator.cpp ****     if (header >= (FreeBlock*)HEAP_END_ADDR) return -1;
  45:src/MemoryAllocator.cpp ****     if(header->next!=(FreeBlock*)((uint64)header^header->size))return -2;
  46:src/MemoryAllocator.cpp ****     FreeBlock* prev=head;
  47:src/MemoryAllocator.cpp ****     FreeBlock* nxt= head->next;
  48:src/MemoryAllocator.cpp ****     if(header<head)
  49:src/MemoryAllocator.cpp ****     {
  50:src/MemoryAllocator.cpp ****         nxt=head;
  51:src/MemoryAllocator.cpp ****         head=header;
  52:src/MemoryAllocator.cpp ****         head->next = nxt;
  53:src/MemoryAllocator.cpp ****         prev= nullptr;
  54:src/MemoryAllocator.cpp ****     }
  55:src/MemoryAllocator.cpp ****     else
  56:src/MemoryAllocator.cpp ****     {
  57:src/MemoryAllocator.cpp ****         while(nxt && header>nxt)
  58:src/MemoryAllocator.cpp ****         {
  59:src/MemoryAllocator.cpp ****             prev=nxt;
  60:src/MemoryAllocator.cpp ****             nxt=nxt->next;
  61:src/MemoryAllocator.cpp ****         }
  62:src/MemoryAllocator.cpp ****         if (prev) prev->next = nxt;
  63:src/MemoryAllocator.cpp ****         else head = nxt;
  64:src/MemoryAllocator.cpp ****     }
  65:src/MemoryAllocator.cpp ****     merge(header,nxt);
  66:src/MemoryAllocator.cpp ****     merge(prev,header);
  67:src/MemoryAllocator.cpp ****     return 0;
  68:src/MemoryAllocator.cpp **** }
